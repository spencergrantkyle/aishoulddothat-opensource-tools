{
  "id": "release",
  "title": "How a code change reaches production",
  "lede": "Every change goes through the same gates: CI, a reviewer, staging, then a promotion. Staging is the gate that runs on real data.",
  "layout": { "rows": "auto 4.5rem auto 4.5rem auto", "minWidth": "48rem" },
  "nodes": [
    { "id": "dev", "kind": "actor", "title": "Developer", "icon": "person", "area": "1 / 1 / 2 / 4" },
    { "id": "main", "title": "main", "icon": "list", "sub": "always deployable", "meta": "", "area": "1 / 5 / 2 / 9" },
    { "id": "staging", "title": "Staging", "icon": "cloud", "sub": "copy of production data", "meta": "", "planned": true, "cols": 1, "area": "1 / 10 / 2 / 13",
      "items": [
        { "id": "migrate", "label": "Migrate", "color": "var(--c2)", "status": "pending" },
        { "id": "smoke", "label": "Smoke", "color": "var(--c4)", "status": "pending" }
      ] },

    { "id": "branch", "title": "Feature branch", "icon": "doc", "sub": "one change", "meta": "", "planned": true, "area": "3 / 1 / 4 / 4" },
    { "id": "ci", "title": "CI", "icon": "gear", "sub": "runs on every push", "planned": true, "cols": 2, "area": "3 / 5 / 4 / 9",
      "items": [
        { "id": "lint", "label": "Lint", "color": "var(--c1)", "status": "pending" },
        { "id": "tests", "label": "Tests", "color": "var(--c2)", "status": "pending" },
        { "id": "build", "label": "Build", "color": "var(--c3)", "status": "pending" },
        { "id": "scan", "label": "Scan", "color": "var(--c4)", "status": "pending" }
      ] },
    { "id": "prod", "title": "Production", "icon": "bolt", "sub": "what users see", "meta": "", "area": "3 / 10 / 4 / 13" },

    { "id": "reviewer", "kind": "actor", "title": "Reviewer", "icon": "eye", "area": "5 / 5 / 6 / 9" }
  ],
  "edges": [
    { "id": "commit", "from": "dev", "fromSide": "bottom", "to": "branch", "toSide": "top" },
    { "id": "pr", "from": "branch", "fromSide": "right", "to": "ci", "toSide": "left" },
    { "id": "review", "from": "reviewer", "fromSide": "top", "to": "ci", "toSide": "bottom" },
    { "id": "merge", "from": "ci", "fromSide": "top", "to": "main", "toSide": "bottom" },
    { "id": "deploy", "from": "main", "fromSide": "right", "to": "staging", "toSide": "left" },
    { "id": "promote", "from": "staging", "fromSide": "bottom", "to": "prod", "toSide": "top" }
  ],
  "steps": [
    { "title": "Production runs the last good build",
      "body": "Nothing reaches users except through the gates below.",
      "active": ["prod"],
      "set": { "prod": { "meta": "v41 live" } } },
    { "title": "A change starts on its own branch",
      "body": "One branch per change keeps each review small and each rollback simple.",
      "active": ["dev", "branch"],
      "flows": [{ "edge": "commit", "label": "commit", "side": "right" }],
      "set": { "branch": { "planned": false, "meta": "fix-login" } } },
    { "title": "Opening a pull request starts CI",
      "body": "Lint, tests, a build and a dependency scan run on every push to the branch.",
      "active": ["branch", "ci"],
      "flows": [{ "edge": "pr", "label": "open PR", "side": "above" }],
      "set": { "ci": { "planned": false, "items": { "lint": "ok", "tests": "ok", "build": "ok", "scan": "ok" } } } },
    { "title": "A second person approves it",
      "body": "CI checks what the code does. The reviewer checks whether it should do it.",
      "active": ["reviewer", "ci"],
      "flows": [{ "edge": "review", "label": "approve", "side": "right" }] },
    { "title": "The change merges into main",
      "body": "main is always deployable, so a merge is only allowed when every check is green and a reviewer has approved.",
      "active": ["ci", "main"],
      "flows": [{ "edge": "merge", "label": "merge", "side": "right" }],
      "set": { "main": { "meta": "v42", "highlight": true }, "branch": { "planned": true, "meta": "merged" } } },
    { "title": "main deploys to staging automatically",
      "body": "Staging runs on a copy of production data, so database migrations meet real rows here first.",
      "active": ["main", "staging"],
      "flows": [{ "edge": "deploy", "label": "deploy", "sub": "v42", "side": "above" }],
      "set": { "staging": { "planned": false, "meta": "v42", "items": { "migrate": "ok", "smoke": "ok" } }, "main": { "highlight": false } } },
    { "title": "Someone promotes it to production",
      "body": "Promotion is a deliberate click, not a side effect of merging.",
      "active": ["staging", "prod"],
      "flows": [{ "edge": "promote", "label": "promote", "sub": "manual", "side": "left" }],
      "set": { "prod": { "meta": "v42 live", "metaMarker": "var(--c4)", "highlight": true } } },
    { "title": "Now suppose a change renames a database column",
      "body": "CI runs its tests on an empty test database. Every check passes, the reviewer approves and it merges.",
      "active": ["ci", "main"],
      "flows": [{ "edge": "merge", "label": "merge", "side": "right" }],
      "set": { "main": { "meta": "v43" }, "prod": { "highlight": false },
               "staging": { "items": { "migrate": "pending", "smoke": "pending" } } } },
    { "title": "Staging catches what CI could not",
      "body": "On real data the migration hits rows the test database never had, and it fails.",
      "active": ["main", "staging"],
      "flows": [{ "edge": "deploy", "label": "deploy", "sub": "v43", "danger": true, "side": "above" }],
      "set": { "staging": { "danger": true, "meta": "v43 failed", "items": { "migrate": "fail" } } } },
    { "title": "So the promotion is blocked, and production never sees it",
      "body": "Production keeps running v42. The fix goes back onto a new branch and starts at the top again.",
      "active": ["staging", "prod"],
      "flows": [{ "edge": "promote", "label": "blocked", "danger": true, "side": "left" }],
      "set": { "prod": { "meta": "v42 live" } } },
    { "title": "That is why staging is a copy of production",
      "body": "Each gate catches a different kind of mistake. Staging is the only one that runs on real data.",
      "active": ["staging"],
      "set": { "staging": { "danger": false, "meta": "waiting for fix", "items": { "migrate": "pending" } }, "main": { "meta": "v43 (reverted)" } } }
  ]
}
